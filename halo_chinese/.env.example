# Cấu hình Halo Chinese Local Backend
PORT=3001
HOST=localhost

# Gemini API Keys (Được bảo vệ tại backend, không đưa ra client)
GEMINI_TEXT_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

GEMINI_LIVE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# Giọng nói mặc định cho Live API (Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_LIVE_VOICE=Aoede

# Đường dẫn file SQLite Database
DATABASE_PATH=./data/halo_chinese.db
